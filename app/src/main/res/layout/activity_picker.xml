<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dc_bg" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/pick_app" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/dc_ink"/>
    <EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/search_hint" android:singleLine="true" android:textColor="@color/dc_ink" android:layout_marginVertical="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/appList"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>
