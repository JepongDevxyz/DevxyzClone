<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dc_bg" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/dc_ink"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Parallel Space-style clones — each clone has its own separate data."
        android:textSize="13sp" android:textColor="@color/dc_mut" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/empty_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/dc_ink" android:visibility="gone"/>
    <TextView android:id="@+id/emptyBody" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/empty_body" android:textSize="14sp" android:textColor="@color/dc_mut" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cloneList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/addCloneBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_clone"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/powered_by" android:gravity="center" android:textSize="11sp"
        android:textColor="@color/dc_mut" android:layout_marginTop="8dp"/>
</LinearLayout>
